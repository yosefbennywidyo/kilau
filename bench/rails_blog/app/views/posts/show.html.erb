<% content_for :title, @post.title %>
<h1><%= @post.title %></h1>
<p><%= @post.content %></p>
<p><a href="/posts/<%= @post.id %>/edit">Edit</a></p>
<form method="post" action="/posts/<%= @post.id %>"><input type="hidden" name="_method" value="delete"><button>Delete</button></form>
<p><a href="/posts">All posts</a></p>
