# GENERATED by `kilau gen entities` from table "posts". Do not edit;
# change the migration and regenerate.
module Entities
  class Post
    TABLE = "posts"
    COLUMNS = ["id", "title", "content", "created_at", "updated_at"]
    SELECT_SQL = "SELECT id, title, content, created_at, updated_at FROM posts"
    INSERT_SQL = "INSERT INTO posts (title, content, created_at, updated_at) VALUES (?, ?, ?, ?)"
    UPDATE_SQL = "UPDATE posts SET title = ?, content = ?, created_at = ?, updated_at = ? WHERE id = ?"
    DELETE_SQL = "DELETE FROM posts WHERE id = ?"

    attr_accessor :id, :title, :content, :created_at, :updated_at

    def self.select_sql = SELECT_SQL

    def self.from_row(row)
      entity = new
      entity.id = row.int(0)
      entity.title = row.text(1)
      entity.content = row.text(2)
      entity.created_at = row.int(3)
      entity.updated_at = row.int(4)
      entity
    end

    def insert_sql = INSERT_SQL
    def update_sql = UPDATE_SQL
    def delete_sql = DELETE_SQL
    def insert_binds = Kilau::DB::Binds.new.text(@title).text(@content).int(@created_at).int(@updated_at)
    def update_binds = Kilau::DB::Binds.new.text(@title).text(@content).int(@created_at).int(@updated_at).int(@id)

    def touch(now)
      @created_at = now if @created_at.nil?
      @updated_at = now
    end
  end
end
